# Shared LiteLLM gateway key; you can also enter it in the local app's Settings.
LITELLM_API_KEY=
# Accepts the base URL or the full /chat/completions URL.
LITELLM_BASE_URL=http://localhost:4000/v1
# Dedicated OpenRouter Decisions passthrough; this is not a chat endpoint.
LITELLM_DECISIONS_URL=http://localhost:4000/openrouter/api/alpha/decisions
PORT=4317
# FLIPPER_DATA_DIR=.data
# Hosted mode requires both values. Generate a long random token privately.
# FLIPPER_PUBLIC_ORIGIN=https://flipper.example.com
# FLIPPER_ADMIN_TOKEN=<generated 64-character token>
# FLIPPER_HOST=0.0.0.0
# Private deployment configuration (not needed for loopback-only local use).
# FLIPPER_DOCKER_NETWORK=web
# FLIPPER_CONTAINER_NAME=flipper-app
# FLIPPER_EDGE_CONTAINER=edge-caddy
